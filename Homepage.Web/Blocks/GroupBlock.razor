@* A row or a vertical stack: flexbox with alignment, gap and wrapping. *@
@{
    var p = Node.PropsAs<GroupProps>();
    var cls = $"grp grp-{(p.Direction == Orientation.Horizontal ? "row" : "col")} justify-{Css.Kebab(p.Justify)} items-{Css.Kebab(p.AlignItems)} gap-{Css.Spacing(p.Gap)}"
              + (p.Wrap ? " grp-wrap" : "") + (p.StackOnMobile ? " grp-stack" : "") + $" {Css.OptionalBackground(p.Background)} pad-box-{Css.Spacing(p.Padding)}";
}
<div class="blk grp-outer">
    <BlockList Nodes="Node.Children" ParentId="@Node.Id" Class="@cls" Wrap="true" />
</div>
@code {
    [Parameter, EditorRequired] public BlockNode Node { get; set; } = default!;
}
