@inject MarkdownRenderer Markdown
@{ var p = Node.PropsAs<MarkdownProps>(); }
@if (string.IsNullOrWhiteSpace(p.Markdown))
{
    @if (Ctx.Edit) { <div class="blk prose hp-placeholder">Empty text block: select it and write in the panel on the right.</div> }
}
else
{
    <div class="blk prose @Css.Align(p.Align)">@((MarkupString)Markdown.ToHtml(p.Markdown, Ctx.Href))</div>
}
@code {
    [Parameter, EditorRequired] public BlockNode Node { get; set; } = default!;
    [CascadingParameter] public RenderContext Ctx { get; set; } = default!;
}
