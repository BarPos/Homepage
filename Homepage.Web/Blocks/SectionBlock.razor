@{ var p = Node.PropsAs<SectionProps>(); }
<section class="sec sec-@p.Variant.ToString().ToLowerInvariant() pad-@Css.Spacing(p.Padding) @Css.Background(p.Background)">
    <div class="container">
        <BlockList Nodes="Node.Children" ParentId="@Node.Id" />
    </div>
</section>
@code {
    [Parameter, EditorRequired] public BlockNode Node { get; set; } = default!;
}
