@{
    var p = Node.PropsAs<ColumnsProps>();
    var cls = $"cols {Css.Ratio(p.Ratio)} gap-{Css.Spacing(p.Gap)} {Css.VAlign(p.VerticalAlign)}"
              + (p.StackOnMobile ? " cols-stack" : " cols-keep") + (p.StackOnMobile && p.ReverseOnMobile ? " cols-reverse" : "");
}
<div class="blk">
    <BlockList Nodes="Node.Children" ParentId="@Node.Id" Class="@cls" Wrap="true" />
</div>
@code {
    [Parameter, EditorRequired] public BlockNode Node { get; set; } = default!;
}
