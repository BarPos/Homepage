@* Also returned alone for htmx "load more" and live search. *@
<div id="post-list">
    @if (Posts.Count == 0)
    {
        <p class="muted">Nothing found.</p>
    }
    <ul class="posts">
        @foreach (var post in Posts)
        {
            <li class="post-card">
                <h3><a href="@post.Url">@post.Title</a></h3>
                <div class="post-meta">@if (!string.IsNullOrEmpty(post.Author)) { <span class="post-author">@post.Author</span><span aria-hidden="true"> · </span> }<time datetime="@post.PublishedAtUtc?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@post.PublishedAtUtc?.ToString("d MMMM yyyy", CultureInfo.InvariantCulture)</time></div>
                @if (!string.IsNullOrWhiteSpace(post.Excerpt)) { <p>@post.Excerpt</p> }
            </li>
        }
    </ul>
    @if (NextUrl is not null)
    {
        <div class="pager" id="pager">
            <a class="btn btn-outline" href="@NextUrl" hx-get="@NextUrl" hx-select="#post-list" hx-target="#post-list" hx-swap="outerHTML">Load more</a>
        </div>
    }
</div>
@code {
    [Parameter, EditorRequired] public List<PostSummary> Posts { get; set; } = [];
    [Parameter] public string? NextUrl { get; set; }
}
