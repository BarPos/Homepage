<CascadingValue Value="Ctx" IsFixed="true">
    <SiteDocument Title="@Item.Title" Description="@Item.Excerpt" Author="@Author" CanonicalUrl="@Canonical" FeedUrl="@FeedPath">
        <article>
            <div class="post-header container sec-narrow">
                <h1>@Item.Title</h1>
                <div class="post-meta">
                    @if (!string.IsNullOrEmpty(Author)) { <span class="post-author">By <strong>@Author</strong></span><span aria-hidden="true"> · </span> }
                    <a class="post-blog" href="/@Blog.Slug">@Blog.Name</a><span aria-hidden="true"> · </span>
                    <time datetime="@Item.PublishedAtUtc?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@Item.PublishedAtUtc?.ToString("d MMMM yyyy", CultureInfo.InvariantCulture)</time><span aria-hidden="true"> · </span>
                    @ContentExtractor.ReadingMinutes(Item.SearchText) min read
                </div>
            </div>
            <div class="post-body container">
                <BlockList Nodes="Tree.Blocks" />
            </div>
        </article>
    </SiteDocument>
</CascadingValue>
@code {
    [Parameter, EditorRequired] public RenderContext Ctx { get; set; } = default!;
    [Parameter, EditorRequired] public ContentItem Item { get; set; } = default!;
    [Parameter, EditorRequired] public BlockTree Tree { get; set; } = default!;
    [Parameter, EditorRequired] public Blog Blog { get; set; } = default!;
    /// <summary>The display name of the post's author; null when the account is gone.</summary>
    [Parameter] public string? Author { get; set; }
    private string FeedPath => "/" + Blog.Slug + "/feed.xml";
    private string? Canonical => string.IsNullOrEmpty(Ctx.Site.BaseUrl) ? null : $"{Ctx.Site.BaseUrl.TrimEnd('/')}/{Blog.Slug}/{Item.Slug}";
}
