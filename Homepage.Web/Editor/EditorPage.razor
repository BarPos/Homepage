<AdminShell Title="@Doc.Title" Full="true" BodyClass="editor">
    <Scripts><script src="@Asset.Url("lib/Sortable.min.js")" defer></script><script src="@Asset.Url("js/editor.js")" defer></script>
        <link rel="stylesheet" href="@Asset.Url("lib/toastui/toastui-editor.css")" />
        <link rel="stylesheet" href="@Asset.Url("lib/toastui/toastui-editor-dark.css")" />
        <script src="@Asset.Url("lib/toastui/toastui-editor.min.js")" defer></script><script src="@Asset.Url("js/md-editor.js")" defer></script></Scripts>
    <ChildContent>
    <div class="ed-bar" data-editor data-target="@Doc.Target" data-region="@Region" data-readonly="@(Doc.CanEdit ? null : "1")">
        <a class="btn btn-sm" href="@BackUrl">← Back</a>
        <span class="title">@Doc.Title</span>
        @if (!Doc.CanEdit) { <span class="badge badge-warn">read-only</span> }
        <span class="status-dot" id="ed-status" title="Saved"></span>
        <span class="spacer"></span>
        <div class="devices" role="group" aria-label="Preview width">
            <button type="button" class="on" data-device="">Desktop</button>
            <button type="button" data-device="tablet">Tablet</button>
            <button type="button" data-device="phone">Phone</button>
        </div>
        @if (Doc.Target.IsTheme && Doc.CanPublish)
        {
            <span class="muted small">Changes are saved as a draft of the theme.</span>
            <a class="btn btn-sm" href="/admin/themes/@Doc.ThemeId">Theme</a>
            <button type="button" class="btn-primary btn-sm" hx-post="/admin/themes/@Doc.ThemeId/publish" hx-swap="none">Publish</button>
        }
        @if (Doc.Target.Kind == EditorTarget.ContentKind)
        {
            <a class="btn btn-sm" href="/admin/content/@Doc.Target.Id">Settings</a>
            @if (Doc.CanPublish)
            {
                <button type="button" class="btn-primary btn-sm" hx-post="/admin/content/@Doc.Target.Id/publish" hx-swap="none">Publish</button>
            }
        }
    </div>
    <div class="ed-main">
        <aside class="ed-left">
            @if (Doc.CanEdit)
            {
                <div class="ed-panel">
                    <h3>Blocks</h3>
                    <div class="help" style="margin-bottom:8px">Drag onto the page or into Layers, or click to add after the selected block.</div>
                    @foreach (var cat in Palette.GroupBy(d => d.Category))
                    {
                        <div class="muted small" style="margin:8px 0 4px">@cat.Key</div>
                        <ul class="palette">
                            @foreach (var d in cat)
                            {
                                <li data-type="@d.Type" title="Drag onto the page or into Layers, or click to add" tabindex="0"><span class="ic">@d.Icon</span>@d.Label</li>
                            }
                        </ul>
                    }
                </div>
            }
            <div class="ed-panel">
                <h3>Layers</h3>
                <div id="layers"><LayersTree Tree="Doc.Tree" /></div>
            </div>
        </aside>
        <section class="ed-canvas" id="ed-canvas">
            <iframe id="canvas" title="Page canvas" src="/admin/editor/@Doc.Target/canvas"></iframe>
        </section>
        <aside class="ed-right">
            <div class="ed-panel inspector" id="inspector"><div class="empty">Select a block to edit its settings.</div></div>
        </aside>
    </div>
    @* Nesting rules for the drag preview (the server enforces them again). Not executed: application/json. *@
    <script type="application/json" id="block-rules">@((MarkupString)RulesJson)</script>
    </ChildContent>
</AdminShell>
@code {
    [Parameter, EditorRequired] public EditorDocument Doc { get; set; } = default!;
    [Parameter] public List<BlockDefinition> Palette { get; set; } = [];
    [Parameter] public string BackUrl { get; set; } = "/admin";
    private static string RulesJson => System.Text.Json.JsonSerializer.Serialize(
        BlockRegistry.All.ToDictionary(d => d.Type, d => new { container = d.IsContainer, children = d.AllowedChildren, parents = d.AllowedParents }))
        .Replace("<", "\\u003c");
    private string Region => Doc.Target.Kind == EditorTarget.ContentKind ? "main" : Doc.Target.Kind;
}
