@using System.Text.Json
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@{ var def = BlockRegistry.Get(Node.Type); }
@if (def is null)
{
    <div class="empty">This block type is not supported by this version. It is kept but not shown on the site.</div>
}
else
{
    var model = Node.Props.Deserialize(def.PropsType, BlockTree.Json) ?? def.CreateDefaultProps();
    <div class="toolbar" style="margin-bottom:6px">
        <strong>@def.Icon @def.Label</strong>
        <span class="spacer"></span>
        @if (CanEdit)
        {
            <button type="button" class="btn-sm" data-op="up" title="Move up">↑</button>
            <button type="button" class="btn-sm" data-op="down" title="Move down">↓</button>
            <button type="button" class="btn-sm" data-op="duplicate" title="Duplicate">⧉</button>
            <button type="button" class="btn-sm btn-danger" data-op="delete" title="Delete (Del)">✕</button>
        }
    </div>
    <form hx-post="/admin/editor/@Target/props/@Node.Id" hx-trigger="input changed delay:500ms, change" hx-swap="none" data-block="@Node.Id">
        <fieldset disabled="@(!CanEdit)" style="border:0;padding:0;margin:0">
        @foreach (var p in def.PropsType.GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            var name = "p." + p.Name;
            var id = "f-" + p.Name;
            var label = p.GetCustomAttribute<DisplayAttribute>()?.Name ?? p.Name;
            var value = p.GetValue(model);
            var t = Nullable.GetUnderlyingType(p.PropertyType) ?? p.PropertyType;
            if (t == typeof(bool))
            {
                <input type="hidden" name="@name" value="false" />
                <label class="inline" style="margin:12px 0 4px"><input type="checkbox" name="@name" value="true" checked="@(value is true)" /> @label</label>
            }
            else if (t.IsEnum)
            {
                <label for="@id">@label</label>
                <select id="@id" name="@name">
                    @foreach (var v in Enum.GetValues(t)) { <option value="@v" selected="@(Equals(v, value))">@(t.GetField(v.ToString()!)?.GetCustomAttribute<DisplayAttribute>()?.Name ?? Humanize(v.ToString()!))</option> }
                </select>
            }
            else if (p.GetCustomAttribute<ThemeColorAttribute>() is { } colorAttr)
            {
                <label for="@id">@label</label>
                <select id="@id" name="@name">
                    @if (colorAttr.AllowNone) { <option value="" selected="@(string.IsNullOrEmpty(value as string))">None</option> }
                    @foreach (var c in ThemeTokens.AllColors.Where(c => ThemeTokens.ColorNames.Contains(c.Key)))
                    {
                        <option value="@c.Key" selected="@(c.Key == (string?)value)">@c.Label</option>
                    }
                </select>
            }
            else if (p.GetCustomAttribute<MediaPickerAttribute>() is not null)
            {
                <label for="@id">@label</label>
                <select id="@id" name="@name" data-search>
                    <option value="">(none)</option>
                    @foreach (var m in Media.Where(m => m.ContentType.StartsWith("image/", StringComparison.Ordinal)))
                    {
                        <option value="@m.Id" selected="@(Equals(m.Id, value))" data-thumb="/media/@m.StoredName">@m.FileName</option>
                    }
                </select>
                <div class="help"><a href="/admin/media" target="_blank">Upload images</a> in Media, then reselect the block.</div>
            }
            else if (p.GetCustomAttribute<IconPickerAttribute>() is not null)
            {
                var current = Icons.Get(value as string);
                _iconFields.Add(id);
                <label for="@id">@label</label>
                <div class="icon-field">
                    <span class="icon-preview" data-icon-preview="@id">@if (current is not null) { @((MarkupString)Icons.Svg(current)) } else { <span class="muted">—</span> }</span>
                    <input id="@id" name="@name" type="text" value="@value" maxlength="80" placeholder="none" readonly />
                    <button type="button" class="btn-sm" data-open-dialog="icon-dialog" data-icon-for="@id">Choose…</button>
                    <button type="button" class="btn-sm" data-icon-clear="@id" title="No icon" aria-label="No icon">✕</button>
                </div>
            }
            else if (p.GetCustomAttribute<BlogPickerAttribute>() is not null)
            {
                <label for="@id">@label</label>
                <select id="@id" name="@name" data-search>
                    <option value="0">All blogs</option>
                    @foreach (var b in Blogs) { <option value="@b.Id" selected="@(Equals(b.Id, value))">@b.Name</option> }
                </select>
            }
            else if (p.GetCustomAttribute<FormPickerAttribute>() is not null)
            {
                <label for="@id">@label</label>
                <select id="@id" name="@name" data-search>
                    <option value="0">(choose a form)</option>
                    @foreach (var f in Forms) { <option value="@f.Id" selected="@(Equals(f.Id, value))">@f.Name@(f.Enabled ? "" : " (closed)")</option> }
                </select>
                <div class="help">Forms are made under <a href="/admin/forms" target="_blank">Forms</a>.</div>
            }
            else if (p.GetCustomAttribute<MailingListPickerAttribute>() is not null)
            {
                <label for="@id">@label</label>
                <select id="@id" name="@name" data-search>
                    <option value="0">(choose a list)</option>
                    @foreach (var l in Lists) { <option value="@l.Id" selected="@(Equals(l.Id, value))">@l.Name</option> }
                </select>
                <div class="help">Lists are made under <a href="/admin/mail/lists" target="_blank">Mail</a>.</div>
            }
            else if (p.GetCustomAttribute<MenuPickerAttribute>() is not null)
            {
                <label for="@id">@label</label>
                <select id="@id" name="@name" data-search>
                    <option value="">(no menu)</option>
                    @foreach (var m in Menus) { <option value="@m.Key" selected="@(m.Key == (string?)value)">@m.Name</option> }
                </select>
            }
            else if (p.GetCustomAttribute<SafeUrlAttribute>() is not null)
            {
                _linkFields = true;
                <label for="@id">@label</label>
                var linkLabel = LinkLabel(value as string);
                <div class="link-field @(linkLabel.Length > 0 ? "has-ref" : null)">
                    <span class="link-chip @(linkLabel.StartsWith('⚠') ? "missing" : linkLabel.Contains("draft:") ? "draft" : null)" title="@linkLabel">
                        <span data-link-resolved="@id">@linkLabel.TrimStart('→', ' ')</span>
                        <button type="button" data-link-clear="@id" title="Remove the link" aria-label="Remove the link">✕</button>
                    </span>
                    <input id="@id" name="@name" type="text" value="@value" maxlength="@(p.GetCustomAttribute<StringLengthAttribute>()?.MaximumLength)" placeholder="/page or https://…" />
                    <button type="button" class="btn-sm" data-open-dialog="link-dialog" data-link-for="@id" title="Choose a page, blog or post">Choose…</button>
                </div>
                <div class="help">A page, blog or post of this site (follows renames and moves), or any address (https://…, mailto:…).</div>
            }
            else if (t == typeof(int))
            {
                var range = p.GetCustomAttribute<RangeAttribute>();
                <label for="@id">@label</label>
                <input id="@id" name="@name" type="number" value="@value" min="@range?.Minimum" max="@range?.Maximum" />
            }
            else if (p.GetCustomAttribute<DataTypeAttribute>()?.DataType == DataType.MultilineText)
            {
                <label for="@id">@label</label>
                @if (Node.Type == "markdown") { _linkFields = true; }
                <textarea id="@id" name="@name" spellcheck="@(Node.Type == "html" ? "false" : "true")" data-md-editor="@(Node.Type == "markdown" ? "" : null)">@value</textarea>
                @if (Node.Type == "markdown") { <div class="help">The canvas updates as you type. In Markdown, <code>[text](https://…){new}</code> makes a link that opens in a new tab.</div> }
            }
            else
            {
                <label for="@id">@label</label>
                <input id="@id" name="@name" type="text" value="@value" maxlength="@(p.GetCustomAttribute<StringLengthAttribute>()?.MaximumLength)" />
            }
        }
        </fieldset>
    </form>
    @if (_linkFields && CanEdit) { <Homepage.Web.Admin.LinkDialog /> }
    @if (_iconFields.Count > 0 && CanEdit)
    {
        @* Outside the form: typing in the search must not save the block. *@
        <dialog id="icon-dialog" class="modal icon-modal" aria-labelledby="icon-dialog-title" data-light-dismiss>
            <h2 id="icon-dialog-title">Choose an icon</h2>
            <input type="search" name="q" placeholder="Search: home, mail, arrow, github…" autocomplete="off" aria-label="Search icons"
                   hx-get="/admin/editor/icons" hx-trigger="input changed delay:200ms, load" hx-target="#icon-results" hx-swap="innerHTML" />
            <div id="icon-results" class="icon-grid" role="listbox" aria-label="Icons"></div>
            <div class="modal-actions">
                <span class="muted small" style="margin-right:auto">Font Awesome Free @Icons.Version · CC BY 4.0</span>
                <button type="button" data-close-dialog>Close</button>
            </div>
        </dialog>
    }
}
@code {
    [Parameter, EditorRequired] public BlockNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public EditorTarget Target { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public List<MediaItem> Media { get; set; } = [];
    [Parameter] public List<Menu> Menus { get; set; } = [];
    [Parameter] public IReadOnlyList<Blog> Blogs { get; set; } = [];
    [Parameter] public IReadOnlyList<Homepage.Forms.Form> Forms { get; set; } = [];
    [Parameter] public IReadOnlyList<Homepage.Mail.MailingList> Lists { get; set; } = [];

    private readonly List<string> _iconFields = [];
    private bool _linkFields;
    [Inject] public SiteTree Tree { get; set; } = default!;
    private SiteMap? _map;
    protected override async Task OnInitializedAsync() => _map = await Tree.GetAsync();

    /// <summary>"→ Team · /about/team" for a reference; a warning when its target is gone; nothing for plain addresses.</summary>
    private string LinkLabel(string? url)
    {
        if (!SafeUrlAttribute.TryParseReference(url, out _, out _)) return "";
        return _map?.Describe(url!) is { } d ? $"→ {d.Title} · {d.Path}{(d.Published ? "" : " · draft: hidden on the site until published")}" : "⚠ The linked page no longer exists. Choose another.";
    }

    private static string Humanize(string s) =>
        System.Text.RegularExpressions.Regex.Replace(s, "(?<=[a-z])(?=[A-Z])", " ");
}
