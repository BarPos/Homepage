<AdminShell Title="Dashboard" Section="dashboard">
    <Actions>
        @if (CreateGroups.Count > 0)
        {
            <button type="button" data-open-dialog="new-content" data-dialog-type="Page">New page</button>
            <button type="button" class="btn-primary" data-open-dialog="new-content" data-dialog-type="Post">New post</button>
        }
    </Actions>
    <ChildContent>
    <div class="stats">
        <a class="stat" href="/admin/content?type=page"><span class="muted">Pages</span><strong>@Pages</strong></a>
        <a class="stat" href="/admin/content?type=post"><span class="muted">Posts</span><strong>@Posts</strong></a>
        <div class="stat"><span class="muted">Drafts</span><strong>@Drafts</strong></div>
        <a class="stat" href="/admin/themes"><span class="muted">Active theme</span><strong class="stat-text">@ThemeName</strong></a>
    </div>
    @if (CreateGroups.Count > 0) { <NewContentForm Groups="CreateGroups" DefaultGroupId="DefaultGroupId" Blogs="Blogs" /> }
    <section>
        <h2 class="section-title">Recently changed</h2>
        <ContentTable Items="Recent" Groups="GroupNames" BlogSlugs="BlogSlugs" BlogNames="BlogNames" HomePageId="HomePageId" />
    </section>
    </ChildContent>
</AdminShell>
@code {
    [Parameter] public int Pages { get; set; }
    [Parameter] public int Posts { get; set; }
    [Parameter] public int Drafts { get; set; }
    [Parameter] public string ThemeName { get; set; } = "";
    [Parameter] public IReadOnlyList<ContentItem> Recent { get; set; } = [];
    [Parameter] public IReadOnlyList<Blog> Blogs { get; set; } = [];
    [Parameter] public int? HomePageId { get; set; }
    private Dictionary<int, string> BlogSlugs => Blogs.ToDictionary(b => b.Id, b => b.Slug);
    private Dictionary<int, string> BlogNames => Blogs.ToDictionary(b => b.Id, b => b.Name);
    [Parameter] public Dictionary<int, string> GroupNames { get; set; } = [];
    [Parameter] public List<Group> CreateGroups { get; set; } = [];
    [Parameter] public int? DefaultGroupId { get; set; }
}
