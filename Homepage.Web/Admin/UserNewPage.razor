<AdminShell Title="New account" Section="access" Back="/admin/users" BackText="Users">
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    <div class="card narrow-card">
        <form method="post" action="/admin/users">
            <input type="hidden" name="__RequestVerificationToken" value="@Token" />
            <label for="un">User name</label>
            <input id="un" name="userName" type="text" required maxlength="64" autocomplete="off" autofocus />
            <div class="help">Used to sign in: 2 to 64 letters, digits, <code>.</code> <code>_</code> <code>-</code> <code>@@</code>.</div>
            <label for="dn">Display name</label>
            <input id="dn" name="displayName" type="text" maxlength="200" />
            <div class="help">Shown in the admin and on their posts. Empty = the user name.</div>
            <label for="em">Email <span class="muted">(optional)</span></label>
            <input id="em" name="email" type="email" maxlength="254" autocomplete="off" />
            <label for="pw">Password <span class="muted">(at least @Homepage.Accounts.AccountService.MinPasswordLength characters)</span></label>
            <input id="pw" name="password" type="password" required autocomplete="new-password" minlength="@Homepage.Accounts.AccountService.MinPasswordLength" />
            <div class="help">They can change it on their profile after signing in.</div>
            <div class="form-actions">
                <button class="btn-primary">Create account</button>
                <a class="btn" href="/admin/users">Cancel</a>
            </div>
        </form>
        <p class="help">New accounts have no permissions until you give them roles or group permissions.</p>
    </div>
</AdminShell>
@code {
    [Parameter] public string? Error { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string Token => HttpContext is null ? "" : AdminContext.From(HttpContext)?.CsrfToken ?? "";
}
