<AdminShell Title="Themes" Section="themes" Subtitle="Built-in themes are read-only: duplicate one to change its colors, fonts, header and footer.">
    <div class="grid2">
        @foreach (var t in Themes)
        {
            var tokens = ThemeTokens.Parse(t.Tokens);
            <div class="card theme-card @(t.IsActive ? "is-active" : null)">
                <div class="badges theme-card-head">
                    <strong class="theme-name">@t.Name</strong>
                    @if (t.IsActive) { <span class="badge badge-ok">Active</span> }
                    @if (t.IsBuiltIn) { <span class="badge">Built-in</span> }
                    @if (t.HasDraft) { <span class="badge badge-warn">Unpublished changes</span> }
                </div>
                <div class="theme-swatches">
                    @foreach (var c in new[] { "bg", "surface-alt", "text", "primary", "accent" })
                    {
                        <span class="swatch" style="background:@tokens.Light[c]" title="@c"></span>
                    }
                    <span class="muted small">· @ThemeTokens.Fonts[tokens.HeadingFont].Label · @tokens.ColorMode</span>
                </div>
                <div class="form-actions">
                    @if (CanEditThemes && !t.IsActive)
                    {
                        <form method="post" action="/admin/themes/@t.Id/activate"><input type="hidden" name="__RequestVerificationToken" value="@Token" /><button class="btn-primary btn-sm">Activate</button></form>
                    }
                    @if (CanEditThemes && !t.IsBuiltIn) { <a class="btn btn-sm" href="/admin/themes/@t.Id">Edit design</a> }
                    @if (CanEditLayout && !t.IsBuiltIn)
                    {
                        <a class="btn btn-sm" href="/admin/editor/header-@t.Id">Header</a>
                        <a class="btn btn-sm" href="/admin/editor/footer-@t.Id">Footer</a>
                    }
                    @if (CanEditThemes)
                    {
                        <form method="post" action="/admin/themes/@t.Id/duplicate"><input type="hidden" name="__RequestVerificationToken" value="@Token" /><button class="btn-sm">Duplicate</button></form>
                    }
                    <a class="btn btn-sm" href="/admin/themes/@t.Id/preview" target="_blank">Preview ↗</a>
                </div>
            </div>
        }
    </div>
</AdminShell>
@code {
    [Parameter] public List<Theme> Themes { get; set; } = [];
    [Parameter] public bool CanEditThemes { get; set; }
    [Parameter] public bool CanEditLayout { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string Token => HttpContext is null ? "" : AdminContext.From(HttpContext)?.CsrfToken ?? "";
}
