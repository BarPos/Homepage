<AdminShell Title="Two-factor sign-in" ShowTitle="false">
    <div class="login">
        <div class="card">
            <h1>Enter your code</h1>
            <p class="muted">Open your authenticator app and enter the 6-digit code for this site. Lost your phone? Enter one of your recovery codes instead.</p>
            @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
            <form method="post" action="/admin/login/2fa">
                <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                <label for="c">Code</label>
                <input id="c" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" required autofocus maxlength="20" class="code-input" />
                <div class="form-actions"><button class="btn-primary" type="submit">Sign in</button><a class="btn" href="/admin/login">Start over</a></div>
            </form>
        </div>
    </div>
</AdminShell>
@code {
    [Parameter] public string Token { get; set; } = "";
    [Parameter] public string? Error { get; set; }
}
