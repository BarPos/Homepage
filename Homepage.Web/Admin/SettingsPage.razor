<AdminShell Title="Settings" Section="settings">
    <Scripts><script src="@Asset.Url("js/update-progress.js")" defer></script></Scripts>
    <ChildContent>
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    @if (!string.IsNullOrEmpty(Message)) { <div class="inline-alert ok">@Message</div> }
    <div class="grid2">
        <div class="card">
            <h2 class="card-title">Site</h2>
            <form method="post" action="/admin/settings">
                <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                <label for="t">Site title</label><input id="t" name="title" type="text" value="@S.Title" maxlength="200" required />
                <label for="tg">Tagline</label><input id="tg" name="tagline" type="text" value="@S.Tagline" maxlength="300" />
                <label for="bu">Public address</label><input id="bu" name="baseUrl" type="text" value="@S.BaseUrl" placeholder="https://example.com" maxlength="300" />
                <div class="help">Used for RSS, the sitemap and canonical links. Leave empty to use the request's address.</div>
                <label for="hp">Home page (what <code>/</code> shows)</label>
                <select id="hp" name="home" data-search>
                    <optgroup label="Pages">
                        @foreach (var p in Pages) { <option value="page:@p.Id" selected="@(p.Id == S.HomePageId)">@p.Title (@(_map?.PagePath(p.Id) ?? "/" + p.Slug))</option> }
                    </optgroup>
                    <optgroup label="Blogs: the list of posts">
                        @foreach (var b in Blogs) { <option value="blog:@b.Id" selected="@(S.HomePageId is null && (S.HomeBlogId ?? Blogs.FirstOrDefault()?.Id) == b.Id)">@b.Name (@(_map?.BlogPath(b.Id) ?? "/" + b.Slug))</option> }
                    </optgroup>
                </select>
                <div class="help">Only published pages are listed. A page can also be chosen with <em>Use as home page</em> in its settings.</div>
                <label for="lg">Logo</label>
                <div class="toolbar" style="margin:0">
                    <select id="lg" name="logoMediaId" style="flex:1" data-search>
                        <option value="">No logo: show the site title as text</option>
                        @foreach (var m in Images) { <option value="@m.Id" selected="@(m.Id == S.LogoMediaId)" data-thumb="/media/@m.StoredName">@m.FileName</option> }
                    </select>
                    @if (LogoUrl is not null) { <img class="thumb" src="@LogoUrl" alt="" /> }
                </div>
                <div class="help">Shown by the <em>Logo / site name</em> block in the header. If the file is deleted, the title is shown instead.</div>
                <fieldset class="favicons">
                    <legend>Favicon</legend>
                    <p class="help">Give one or more: each browser uses the best format it supports. Upload them in <a href="/admin/media">Media</a>.</p>
                    @foreach (var (name, label, help, types, current) in FaviconSlots)
                    {
                        <div class="favicon-row">
                            <span class="favicon-thumb">@if (Images.FirstOrDefault(m => m.Id == current) is { } f) { <img src="/media/@f.StoredName" alt="" /> } else { <span class="muted">—</span> }</span>
                            <div>
                                <label for="@name">@label</label>
                                <select id="@name" name="@name" data-search>
                                    <option value="">None</option>
                                    @foreach (var m in Images.Where(m => types.Contains(m.ContentType))) { <option value="@m.Id" selected="@(m.Id == current)" data-thumb="/media/@m.StoredName">@m.FileName</option> }
                                </select>
                                <div class="help">@help</div>
                            </div>
                        </div>
                    }
                </fieldset>
                <label for="dg">Default group for new content</label>
                <select id="dg" name="defaultGroupId" data-search>
                    @foreach (var g in Groups) { <option value="@g.Id" selected="@(g.Id == S.DefaultGroupId)">@g.Name</option> }
                </select>
                <div class="form-actions"><button class="btn-primary">Save</button></div>
            </form>
        </div>
        <div class="card">
            <h2 class="card-title">About and updates</h2>
            <p>Version <strong>@Update.CurrentVersion</strong></p>
            @if (!Update.Configured)
            {
                <p class="muted">Updates are not configured (Updates:GitHubRepository is empty), so the server makes no update checks.</p>
            }
            else
            {
                <p>Latest release: @(Update.Latest?.Version ?? "unknown")
                    @if (Update.LastCheckedUtc is { } c) { <span class="muted small">· checked @c.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</span> }</p>
                @if (Update.LastError is { } err) { <p class="inline-alert">@err</p> }
                @if (Update.Latest?.Notes is { Length: > 0 } notes) { <details><summary>Release notes</summary><pre style="white-space:pre-wrap">@notes</pre></details> }
                <div class="form-actions">
                    <form method="post" action="/admin/updates/check"><input type="hidden" name="__RequestVerificationToken" value="@Token" /><button>Check now</button></form>
                    @if (Update.UpdateAvailable)
                    {
                        <form method="post" action="/admin/updates/apply" data-update-form
                              data-from="@Update.CurrentVersion" data-to="@Update.Latest?.Version"
                              data-confirm="The database is backed up first, then the site restarts with the new version. It is unavailable for a short while; if the new version does not start, the old one comes back automatically."
                              data-confirm-title="@UpdateTitle" data-confirm-button="Update now">
                            <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                            <button class="btn-primary" disabled="@(!Update.SelfUpdateSupported)">Update now</button>
                        </form>
                    }
                </div>
                @if (!Update.SelfUpdateSupported) { <p class="help">@Update.UnsupportedReason</p> }
            }
            @if (Update.LastRun is { } run)
            {
                <p class="small">Last update: @run.FromVersion → @run.ToVersion: <strong>@run.State</strong> @run.Message</p>
            }
        </div>
    </div>
    </ChildContent>
</AdminShell>
@code {
    [Parameter, EditorRequired] public SiteSettings S { get; set; } = default!;
    [Parameter] public List<ContentItem> Pages { get; set; } = [];
    [Parameter] public IReadOnlyList<Blog> Blogs { get; set; } = [];
    [Parameter] public List<MediaItem> Images { get; set; } = [];
    private string? LogoUrl => Images.FirstOrDefault(m => m.Id == S.LogoMediaId) is { } m ? "/media/" + m.StoredName : null;
    private (string Name, string Label, string Help, string[] Types, int? Current)[] FaviconSlots =>
    [
        ("faviconSvgMediaId", "SVG", "Sharp at every size; modern browsers prefer it. Can follow light and dark mode with a media query inside the file.", ["image/svg+xml"], S.FaviconSvgMediaId),
        ("faviconMediaId", "PNG", "Square, at least 180 × 180. Also the icon when the site is added to an iPhone or iPad home screen.", ["image/png", "image/x-icon"], S.FaviconMediaId),
        ("faviconIcoMediaId", "ICO", "For older browsers and tools that only ask for /favicon.ico.", ["image/x-icon"], S.FaviconIcoMediaId),
    ];
    [Parameter] public List<Group> Groups { get; set; } = [];
    [Parameter, EditorRequired] public Homepage.Updates.UpdateStatus Update { get; set; } = default!;
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Error { get; set; }
    private string UpdateTitle => $"Update to {Update.Latest?.Version}?";
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string Token => HttpContext is null ? "" : AdminContext.From(HttpContext)?.CsrfToken ?? "";
    [Inject] public SiteTree Tree { get; set; } = default!;
    private SiteMap? _map;
    protected override async Task OnInitializedAsync() => _map = await Tree.GetAsync();
}
