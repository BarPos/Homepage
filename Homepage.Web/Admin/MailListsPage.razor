@using Homepage.Mail
<AdminShell Title="Mail" Section="mail" Subtitle="Email from this site: answers to forms, newsletters and account notices.">
    <MailTabs Active="lists" />
    @if (!string.IsNullOrEmpty(Message)) { <div class="inline-alert ok">@Message</div> }
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    @if (Lists.Count == 0)
    {
        <div class="card empty-state">
            <h2>No mailing lists yet</h2>
            <p class="muted">Make a list, then let visitors sign up with a Newsletter sign-up block (or a consent checkbox in a form).</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>List</th><th>Subscribed</th><th>Waiting for confirmation</th><th>Sign-up</th><th></th></tr></thead>
                <tbody>
                    @foreach (var l in Lists)
                    {
                        var (subscribed, pending) = Counts.GetValueOrDefault(l.Id);
                        <tr>
                            <td><a href="/admin/mail/lists/@l.Id"><strong>@l.Name</strong></a>@if (l.Description.Length > 0) { <div class="muted small">@l.Description</div> }</td>
                            <td>@subscribed</td>
                            <td class="muted">@pending</td>
                            <td class="muted small">@(l.DoubleOptIn ? "confirm by email (double opt-in)" : "at once")</td>
                            <td class="right nowrap">
                                <a class="btn btn-sm" href="/admin/mail/lists/@l.Id">Subscribers</a>
                                @if (CanWrite) { <a class="btn btn-sm" href="/admin/mail/send?list=@l.Id">Send email</a> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (CanWrite)
    {
        <form method="post" action="/admin/mail/lists" class="card">
            <input type="hidden" name="__RequestVerificationToken" value="@Token" />
            <h2 class="card-title">New list</h2>
            <div class="form-row">
                <div><label for="ln">Name</label><input id="ln" name="name" type="text" maxlength="100" required placeholder="Newsletter" /><div class="help">Subscribers see it in emails and on the confirm and unsubscribe pages.</div></div>
                <div><label for="ld">Description</label><input id="ld" name="description" type="text" maxlength="500" placeholder="Monthly news (optional, only shown here)" /></div>
            </div>
            <label class="inline" style="margin-top:12px"><input type="checkbox" name="doubleOptIn" value="true" checked /> New subscribers confirm by clicking a link in an email (recommended; required by law in many countries)</label>
            <div class="form-actions"><button class="btn-primary">Create list</button></div>
        </form>
    }
</AdminShell>
@code {
    [Parameter] public List<MailingList> Lists { get; set; } = [];
    [Parameter] public Dictionary<int, (int Subscribed, int Pending)> Counts { get; set; } = [];
    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Error { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string Token => HttpContext is null ? "" : AdminContext.From(HttpContext)?.CsrfToken ?? "";
}
