@* Paging for every admin list. Lives inside the swapped element, so it updates with the rows. *@
<nav class="pager-bar" aria-label="Pages">
    <span class="muted small">@(Total == 0 ? "No results" : $"{From}–{To} of {Total}")</span>
    <span class="spacer"></span>
    @if (TotalPages > 1)
    {
        <a class="btn btn-sm @(Page <= 1 ? "disabled" : "")" href="@Url.Page(Math.Max(1, Page - 1))" hx-get="@Url.Page(Math.Max(1, Page - 1))"
           hx-target="@Target" hx-select="@Target" hx-swap="outerHTML" hx-push-url="true" aria-disabled="@(Page <= 1 ? "true" : null)">‹ Previous</a>
        @foreach (var p in Pages())
        {
            if (p == 0) { <span class="muted">…</span> }
            else
            {
                <a class="btn btn-sm @(p == Page ? "btn-primary" : "")" href="@Url.Page(p)" hx-get="@Url.Page(p)" hx-target="@Target" hx-select="@Target"
                   hx-swap="outerHTML" hx-push-url="true" aria-current="@(p == Page ? "page" : null)">@p</a>
            }
        }
        <a class="btn btn-sm @(Page >= TotalPages ? "disabled" : "")" href="@Url.Page(Math.Min(TotalPages, Page + 1))" hx-get="@Url.Page(Math.Min(TotalPages, Page + 1))"
           hx-target="@Target" hx-select="@Target" hx-swap="outerHTML" hx-push-url="true" aria-disabled="@(Page >= TotalPages ? "true" : null)">Next ›</a>
    }
</nav>
@code {
    [Parameter, EditorRequired] public ListUrl Url { get; set; } = default!;
    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public int From { get; set; }
    [Parameter] public int To { get; set; }
    [Parameter] public string Target { get; set; } = "#list";

    /// <summary>1, …, around the current page, …, last (0 = gap).</summary>
    private IEnumerable<int> Pages()
    {
        var set = new SortedSet<int> { 1, TotalPages };
        for (var p = Page - 2; p <= Page + 2; p++) if (p >= 1 && p <= TotalPages) set.Add(p);
        var prev = 0;
        foreach (var p in set)
        {
            if (prev != 0 && p > prev + 1) yield return 0;
            yield return p;
            prev = p;
        }
    }
}
