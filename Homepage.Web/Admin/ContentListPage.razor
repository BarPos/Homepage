<AdminShell Title="@(Type == ContentType.Post ? "Posts" : "Pages")" Section="@(Type == ContentType.Post ? "posts" : "pages")">
    @if (CreateGroups.Count > 0)
    {
        <div class="card"><NewContentForm Groups="CreateGroups" DefaultGroupId="DefaultGroupId" Type="Type" /></div>
    }
    <form class="toolbar" hx-get="/admin/content" hx-target="#content-table" hx-select="#content-table" hx-swap="outerHTML"
          hx-trigger="input changed delay:300ms from:input, change from:select" hx-push-url="true">
        <input type="hidden" name="type" value="@Type" />
        <input type="search" name="q" value="@Search" placeholder="Search titles…" style="max-width:280px" />
        <select name="groupId" style="max-width:200px">
            <option value="">All groups I can see</option>
            @foreach (var (id, name) in Groups) { <option value="@id" selected="@(id == GroupId)">@name</option> }
        </select>
    </form>
    <ContentTable Items="Items" Groups="Groups" />
</AdminShell>
@code {
    [Parameter] public ContentType Type { get; set; }
    [Parameter] public List<ContentItem> Items { get; set; } = [];
    [Parameter] public Dictionary<int, string> Groups { get; set; } = [];
    [Parameter] public List<Group> CreateGroups { get; set; } = [];
    [Parameter] public int? DefaultGroupId { get; set; }
    [Parameter] public int? GroupId { get; set; }
    [Parameter] public string? Search { get; set; }
}
