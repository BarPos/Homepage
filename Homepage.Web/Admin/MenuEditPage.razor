@{ var isNew = Menu is null; }
<AdminShell Title="@(isNew ? "New menu" : Name)" Section="menus" Back="/admin/menus" BackText="Menus">
    <Actions>
        @if (!isNew)
        {
            <form method="post" action="/admin/menus/@Menu!.Key/delete" data-confirm="Menu blocks that show it become empty." data-confirm-title="Delete the menu '@Menu.Name'?" data-confirm-button="Delete menu" data-confirm-danger>
                <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                <button class="btn-danger">Delete menu</button>
            </form>
        }
    </Actions>
    <ChildContent>
    @if (!string.IsNullOrEmpty(Message)) { <div class="inline-alert ok">@Message</div> }
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    <form method="post" action="@(isNew ? "/admin/menus" : $"/admin/menus/{Menu!.Key}")" class="card menu-editor" x-data="{ rows: @RowsJson() }">
        <input type="hidden" name="__RequestVerificationToken" value="@Token" />
        <div class="form-row">
            <div>
                <label for="mn">Name</label>
                <input id="mn" name="name" type="text" value="@Name" maxlength="100" required placeholder="Social links" autofocus="@isNew" />
            </div>
            <div>
                <label for="mk">Key</label>
                @if (isNew)
                {
                    <input id="mk" name="key" type="text" value="@Key" maxlength="50" placeholder="made from the name" />
                }
                else
                {
                    <input id="mk" type="text" value="@Menu!.Key" disabled />
                }
                <div class="help">Menu blocks refer to the menu by its key@(isNew ? "; it cannot be changed later" : "").</div>
            </div>
        </div>
        <h2 class="card-title" style="margin-top:20px">Links</h2>
        <div class="link-rows">
            <div class="link-row link-row-head muted small" x-show="rows.length"><span>Icon</span><span>Label</span><span>Link</span><span class="center" title="Open in a new tab">New tab</span><span></span></div>
            <template x-for="(row, i) in rows" :key="row.id">
                <div class="link-row">
                    <span class="icon-field compact">
                        <button type="button" class="icon-preview icon-pick" data-open-dialog="icon-dialog" x-bind:data-icon-for="'icon-' + row.id"
                                title="Choose an icon" aria-label="Choose an icon" x-html="row.svg || '<span class=&quot;muted&quot;>+</span>'"></button>
                        <input type="hidden" name="icon" x-bind:id="'icon-' + row.id" x-model="row.icon" x-on:hp-icon="row.svg = $event.detail.svg" />
                    </span>
                    <input type="text" name="label" x-model="row.label" placeholder="Label" aria-label="Label" maxlength="100" />
                    <span class="link-field" data-url-field x-bind:class="/^(page|post|blog):\d+$/.test(row.url) && 'has-ref'"
                          x-on:hp-link.window="if ($event.detail.id === 'url-' + row.id) row.target = $event.detail.label">
                        <span class="link-chip" x-bind:class="row.target.startsWith('⚠') ? 'missing' : row.target.includes('draft:') ? 'draft' : ''" x-bind:title="row.target">
                            <span x-text="row.target.replace(/^→ /, '')"></span>
                            <button type="button" x-on:click="row.url = ''; row.target = ''; $nextTick(() => $el.closest('.link-field').querySelector('input').focus())" title="Remove the link" aria-label="Remove the link">✕</button>
                        </span>
                        <input type="text" name="url" x-bind:id="'url-' + row.id" x-model="row.url" placeholder="/page or https://…" aria-label="Link" maxlength="1000" />
                        <button type="button" class="btn-sm" data-open-dialog="link-dialog" x-bind:data-link-for="'url-' + row.id" title="Choose a page, blog or post">Choose…</button>
                    </span>
                    <label class="inline new-tab" title="Open in a new tab">
                        <input type="hidden" name="newTab" x-bind:value="row.newTab ? 'true' : 'false'" />
                        <input type="checkbox" x-model="row.newTab" aria-label="Open in a new tab" />
                    </label>
                    <span class="row-tools">
                        <button type="button" class="btn-sm icon" x-show="row.icon" x-on:click="row.icon = ''; row.svg = ''" title="Remove the icon" aria-label="Remove the icon">⌫</button>
                        <button type="button" class="btn-sm icon" x-on:click="if (i > 0) rows.splice(i - 1, 0, rows.splice(i, 1)[0])" x-bind:disabled="i === 0" title="Move up" aria-label="Move up">↑</button>
                        <button type="button" class="btn-sm icon" x-on:click="if (i < rows.length - 1) rows.splice(i + 1, 0, rows.splice(i, 1)[0])" x-bind:disabled="i === rows.length - 1" title="Move down" aria-label="Move down">↓</button>
                        <button type="button" class="btn-sm icon" x-on:click="rows.splice(i, 1)" title="Remove link" aria-label="Remove link">✕</button>
                    </span>
                </div>
            </template>
            <p class="muted" x-show="!rows.length">No links yet.</p>
        </div>
        <div class="form-actions spread">
            <button type="button" x-on:click="rows.push({ id: Date.now() + Math.random(), label: '', url: '', icon: '', svg: '', newTab: false, target: '' }); $nextTick(() => $root.querySelectorAll('input[name=label]')[rows.length - 1]?.focus())">+ Add link</button>
            <span>
                <a class="btn" href="/admin/menus">Cancel</a>
                <button class="btn-primary">@(isNew ? "Create menu" : "Save menu")</button>
            </span>
        </div>
    </form>
    <LinkDialog />
    <dialog id="icon-dialog" class="modal icon-modal" aria-labelledby="icon-dialog-title" data-light-dismiss>
        <h2 id="icon-dialog-title">Choose an icon</h2>
        <input type="search" name="q" placeholder="Search: home, mail, arrow, github…" autocomplete="off" aria-label="Search icons"
               hx-get="/admin/editor/icons" hx-trigger="input changed delay:200ms, load" hx-target="#icon-results" hx-swap="innerHTML" form="none" />
        <div id="icon-results" class="icon-grid" role="listbox" aria-label="Icons"></div>
        <div class="modal-actions">
            <span class="muted small" style="margin-right:auto">Font Awesome Free @Icons.Version · CC BY 4.0</span>
            <button type="button" data-close-dialog>Close</button>
        </div>
    </dialog>
    </ChildContent>
</AdminShell>
@code {
    /// <summary>The menu being edited; null for a new one.</summary>
    [Parameter] public Menu? Menu { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public IReadOnlyList<MenuLink> Links { get; set; } = [];
    [Inject] public SiteTree Tree { get; set; } = default!;
    private SiteMap? Map;
    protected override async Task OnInitializedAsync() => Map = await Tree.GetAsync();
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Error { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string Token => HttpContext is null ? "" : AdminContext.From(HttpContext)?.CsrfToken ?? "";
    private string RowsJson() =>
        System.Text.Json.JsonSerializer.Serialize(Links.Select((l, i) => new
        {
            id = i, label = l.Label, url = l.Url, icon = l.Icon ?? "", newTab = l.NewTab,
            target = Map?.Describe(l.Url) is { } d ? $"→ {d.Title} · {d.Path}{(d.Published ? "" : " · draft: hidden on the site until published")}"
                : SafeUrlAttribute.TryParseReference(l.Url, out _, out _) ? "⚠ The linked page no longer exists" : "",
            svg = Icons.Get(l.Icon) is { } ic ? Icons.Svg(ic) : "",
        }));
}
