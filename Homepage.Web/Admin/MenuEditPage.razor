@{ var isNew = Menu is null; }
<AdminShell Title="@(isNew ? "New menu" : Name)" Section="menus" Back="/admin/menus" BackText="Menus">
    <Actions>
        @if (!isNew)
        {
            <form method="post" action="/admin/menus/@Menu!.Key/delete" data-confirm="Menu blocks that show it become empty." data-confirm-title="Delete the menu '@Menu.Name'?" data-confirm-button="Delete menu" data-confirm-danger>
                <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                <button class="btn-danger">Delete menu</button>
            </form>
        }
    </Actions>
    <ChildContent>
    @if (!string.IsNullOrEmpty(Message)) { <div class="inline-alert ok">@Message</div> }
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    <form method="post" action="@(isNew ? "/admin/menus" : $"/admin/menus/{Menu!.Key}")" class="card menu-editor" x-data="{ rows: @RowsJson() }">
        <input type="hidden" name="__RequestVerificationToken" value="@Token" />
        <div class="form-row">
            <div>
                <label for="mn">Name</label>
                <input id="mn" name="name" type="text" value="@Name" maxlength="100" required placeholder="Social links" autofocus="@isNew" />
            </div>
            <div>
                <label for="mk">Key</label>
                @if (isNew)
                {
                    <input id="mk" name="key" type="text" value="@Key" maxlength="50" placeholder="made from the name" />
                }
                else
                {
                    <input id="mk" type="text" value="@Menu!.Key" disabled />
                }
                <div class="help">Menu blocks refer to the menu by its key@(isNew ? "; it cannot be changed later" : "").</div>
            </div>
        </div>
        <h2 class="card-title" style="margin-top:20px">Links</h2>
        <div class="link-rows">
            <div class="link-row link-row-head muted small" x-show="rows.length"><span>Label</span><span>Link</span><span></span></div>
            <template x-for="(row, i) in rows" :key="row.id">
                <div class="link-row">
                    <input type="text" name="label" x-model="row.label" placeholder="Label" aria-label="Label" maxlength="100" />
                    <input type="text" name="url" x-model="row.url" placeholder="/page or https://…" aria-label="Link" maxlength="1000" />
                    <span class="row-tools">
                        <button type="button" class="btn-sm icon" x-on:click="if (i > 0) rows.splice(i - 1, 0, rows.splice(i, 1)[0])" x-bind:disabled="i === 0" title="Move up" aria-label="Move up">↑</button>
                        <button type="button" class="btn-sm icon" x-on:click="if (i < rows.length - 1) rows.splice(i + 1, 0, rows.splice(i, 1)[0])" x-bind:disabled="i === rows.length - 1" title="Move down" aria-label="Move down">↓</button>
                        <button type="button" class="btn-sm icon" x-on:click="rows.splice(i, 1)" title="Remove link" aria-label="Remove link">✕</button>
                    </span>
                </div>
            </template>
            <p class="muted" x-show="!rows.length">No links yet.</p>
        </div>
        <div class="form-actions spread">
            <button type="button" x-on:click="rows.push({ id: Date.now() + Math.random(), label: '', url: '' }); $nextTick(() => $root.querySelectorAll('input[name=label]')[rows.length - 1]?.focus())">+ Add link</button>
            <span>
                <a class="btn" href="/admin/menus">Cancel</a>
                <button class="btn-primary">@(isNew ? "Create menu" : "Save menu")</button>
            </span>
        </div>
    </form>
    </ChildContent>
</AdminShell>
@code {
    /// <summary>The menu being edited; null for a new one.</summary>
    [Parameter] public Menu? Menu { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public IReadOnlyList<MenuLink> Links { get; set; } = [];
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Error { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string Token => HttpContext is null ? "" : AdminContext.From(HttpContext)?.CsrfToken ?? "";
    private string RowsJson() =>
        System.Text.Json.JsonSerializer.Serialize(Links.Select((l, i) => new { id = i, label = l.Label, url = l.Url }));
}
