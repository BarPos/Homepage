<AdminShell Title="@U.UserName" Section="access" Back="/admin/users" BackText="Users" Subtitle="@U.DisplayName">
    <Badges>
        @if (U.Valid) { <span class="badge badge-ok">valid</span> } else { <span class="badge badge-off">invalid</span> }
        @if (U.TwoFactorEnabled) { <span class="badge">2FA on</span> }
    </Badges>
    <ChildContent>
    @if (!string.IsNullOrEmpty(Message)) { <div class="inline-alert ok">@Message</div> }
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    <div class="grid2">
        <div class="stack">
            <section class="card">
                <h2 class="card-title">Account</h2>
                <form method="post" action="/admin/users/@U.Id">
                    <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                    <label for="dn">Display name</label>
                    <input id="dn" name="displayName" type="text" value="@U.DisplayName" maxlength="200" />
                    <label for="em">Email</label>
                    <input id="em" name="email" type="email" value="@U.Email" maxlength="254" autocomplete="off" />
                    <label class="inline check"><input type="checkbox" name="valid" value="true" checked="@U.Valid" /> Valid (can sign in)</label>
                    <div class="form-actions"><button class="btn-primary">Save</button></div>
                </form>
            </section>
            <section class="card">
                <h2 class="card-title">Password</h2>
                <form method="post" action="/admin/users/@U.Id/password">
                    <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                    <label for="pw">New password</label>
                    <input id="pw" name="password" type="password" required autocomplete="new-password" minlength="@Homepage.Accounts.AccountService.MinPasswordLength" />
                    <div class="help">Signs them out everywhere.</div>
                    <div class="form-actions"><button>Set password</button></div>
                </form>
            </section>
            <section class="card">
                <h2 class="card-title">Two-factor sign-in</h2>
                @if (U.TwoFactorEnabled)
                {
                    <p class="muted">On. If they lost their phone and their recovery codes, turn it off so they can sign in with the password alone and set it up again.</p>
                    <form method="post" action="/admin/users/@U.Id/2fa/disable" data-confirm="They will sign in with the password alone until they set it up again." data-confirm-title="Turn off two-factor sign-in?" data-confirm-button="Turn off" data-confirm-danger>
                        <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                        <button class="btn-danger">Turn off two-factor sign-in</button>
                    </form>
                }
                else
                {
                    <p class="muted">Off. Each user sets it up on their own profile.</p>
                }
            </section>
        </div>
        <section class="card">
            <h2 class="card-title">Effective permissions</h2>
            <p class="help">Union of direct grants and the user's valid roles, on valid groups. Change them under <a href="/admin/permissions/user-groups">Users ↔ Groups</a> and <a href="/admin/permissions/user-roles">Users ↔ Roles</a>.</p>
            @if (Effective.IsAdmin) { <p><span class="badge badge-ok">admin: rw</span> full access everywhere</p> }
            <div class="table-wrap">
            <table class="matrix">
                <thead><tr><th>Group</th>@foreach (var (_, k) in PermNames.All) { <th>@k</th> }</tr></thead>
                <tbody>
                    @foreach (var g in Groups.Where(g => g.Valid))
                    {
                        <tr><td>@g.Name</td>@foreach (var (p, _) in PermNames.All) { <td>@(Effective.Has(g.Id, p) ? "✓" : "")</td> }</tr>
                    }
                </tbody>
            </table>
            </div>
        </section>
    </div>
    </ChildContent>
</AdminShell>
@code {
    [Parameter, EditorRequired] public User U { get; set; } = default!;
    [Parameter] public List<Group> Groups { get; set; } = [];
    [Parameter] public EffectivePermissions Effective { get; set; } = EffectivePermissions.Nobody;
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Error { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string Token => HttpContext is null ? "" : AdminContext.From(HttpContext)?.CsrfToken ?? "";
}
