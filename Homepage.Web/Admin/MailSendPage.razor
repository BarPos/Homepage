@using Homepage.Mail
<AdminShell Title="Mail" Section="mail" Subtitle="Email from this site: answers to forms, newsletters and account notices.">
    <MailTabs Active="send" />
    @if (!string.IsNullOrEmpty(Message)) { <div class="inline-alert ok">@Message</div> }
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    @if (!MailReady) { <div class="inline-alert warn">Email is not set up on this server: emails wait in the outbox until it is. See <a href="/admin/mail">Overview</a>.</div> }
    @if (Lists.Count == 0)
    {
        <div class="card empty-state"><h2>No mailing lists yet</h2><p class="muted">Make a list first, under <a href="/admin/mail/lists">Mailing lists</a>.</p></div>
    }
    else
    {
        <form method="post" action="/admin/mail/send" class="card mail-compose" data-templates="@TemplatesJson()"
              x-data="{ subject: $el.dataset.subject, body: $el.dataset.body, templates: JSON.parse($el.dataset.templates), use(id) { const t = this.templates.find(x => x.id == id); if (t) { this.subject = t.subject; this.body = t.body; } } }"
              data-subject="@Subject" data-body="@Body">
            <input type="hidden" name="__RequestVerificationToken" value="@Token" />
            <div class="form-row">
                <div>
                    <label for="ml">To</label>
                    <select id="ml" name="listId" required>
                        @foreach (var l in Lists)
                        {
                            var (n, _) = Counts.GetValueOrDefault(l.Id);
                            <option value="@l.Id" selected="@(l.Id == ListId)">@l.Name (@n subscribed)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="mt">Start from a template</label>
                    <select id="mt" x-on:change="use($event.target.value)" disabled="@(Templates.Count == 0)">
                        <option value="">@(Templates.Count == 0 ? "(no templates yet)" : "(choose)")</option>
                        @foreach (var t in Templates) { <option value="@t.Id">@t.Name</option> }
                    </select>
                </div>
            </div>
            <label for="ms">Subject</label>
            <input id="ms" name="subject" type="text" maxlength="200" required x-model="subject" />
            <label for="mb">Text</label>
            <textarea id="mb" name="body" rows="16" class="mono" x-model="body" placeholder="Hello{{name.comma}}&#10;&#10;Write in Markdown: **bold**, *italic*, [a link](https://…), # Heading, - lists."></textarea>
            <div class="help">Markdown. Placeholders: <code>{{name}}</code>, <code>{{name.comma}}</code> (“ Ann,” or “,”), <code>{{email}}</code>, <code>{{list.name}}</code>, <code>{{site.title}}</code>, <code>{{site.url}}</code>. Every email ends with an unsubscribe link.</div>
            <div class="form-actions spread">
                <button class="btn" name="action" value="test" formnovalidate>Send a test to me</button>
                <button class="btn-primary" name="action" value="send" data-confirm="Each subscriber of the chosen list gets this email. It cannot be called back." data-confirm-title="Send to the whole list?" data-confirm-button="Send">Send to the list</button>
            </div>
        </form>
    }
</AdminShell>
@code {
    [Parameter] public List<MailingList> Lists { get; set; } = [];
    [Parameter] public Dictionary<int, (int Subscribed, int Pending)> Counts { get; set; } = [];
    [Parameter] public List<EmailTemplate> Templates { get; set; } = [];
    [Parameter] public int? ListId { get; set; }
    [Parameter] public string Subject { get; set; } = "";
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public bool MailReady { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Error { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string Token => HttpContext is null ? "" : AdminContext.From(HttpContext)?.CsrfToken ?? "";
    private string TemplatesJson() => System.Text.Json.JsonSerializer.Serialize(Templates.Select(t => new { id = t.Id, subject = t.Subject, body = t.Body }));
}
