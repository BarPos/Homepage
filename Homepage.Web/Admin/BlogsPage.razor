<AdminShell Title="Blogs" Section="blogs" Subtitle="Each blog lists its posts at its own address and has its own RSS feed.">
    <Actions><a class="btn btn-primary" href="/admin/blogs/new">New blog</a></Actions>
    <ChildContent>
    @if (!string.IsNullOrEmpty(Message)) { <div class="inline-alert ok">@Message</div> }
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    <div class="table-wrap">
        <table>
            <thead><tr><th>Blog</th><th>Address</th><th class="num">Posts</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in Blogs)
                {
                    <tr>
                        <td>
                            <span class="badges"><a href="/admin/blogs/@b.Id"><strong>@b.Name</strong></a>@if (b.Id == HomeBlogId) { <span class="badge badge-ok" title="The home page shows this blog">home</span> }</span>
                            @if (!string.IsNullOrEmpty(b.Description)) { <div class="muted small">@b.Description</div> }
                        </td>
                        <td><a href="/@b.Slug" target="_blank" rel="noopener"><code>/@b.Slug</code> ↗</a></td>
                        <td class="num"><a href="/admin/content?type=post&blog=@b.Id">@PostCounts.GetValueOrDefault(b.Id)</a></td>
                        <td class="right"><a class="btn btn-sm" href="/admin/blogs/@b.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </ChildContent>
</AdminShell>
@code {
    [Parameter] public IReadOnlyList<Blog> Blogs { get; set; } = [];
    [Parameter] public Dictionary<int, int> PostCounts { get; set; } = [];
    [Parameter] public int? HomeBlogId { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Error { get; set; }
}
