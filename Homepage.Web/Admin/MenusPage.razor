<AdminShell Title="Menus" Section="menus" Subtitle="A Menu block in a page, the header or the footer shows one of these menus.">
    <Actions><a class="btn btn-primary" href="/admin/menus/new">New menu</a></Actions>
    <ChildContent>
    @if (!string.IsNullOrEmpty(Message)) { <div class="inline-alert ok">@Message</div> }
    @if (!string.IsNullOrEmpty(Error)) { <div class="inline-alert">@Error</div> }
    @if (Menus.Count == 0)
    {
        <div class="card empty-state">
            <h2>No menus yet</h2>
            <p class="muted">Make one, then show it with a Menu block in the header.</p>
            <a class="btn btn-primary" href="/admin/menus/new">New menu</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Menu</th><th>Key</th><th>Links</th><th></th></tr></thead>
                <tbody>
                    @foreach (var m in Menus)
                    {
                        var links = MenuService.Parse(m.Items);
                        <tr>
                            <td><a href="/admin/menus/@m.Key"><strong>@m.Name</strong></a></td>
                            <td><code>@m.Key</code></td>
                            <td class="muted">@if (links.Count == 0) { <span>No links</span> } else { <span>@string.Join(" · ", links.Take(6).Select(l => l.Label))@(links.Count > 6 ? $" and {links.Count - 6} more" : "")</span> }</td>
                            <td class="right"><a class="btn btn-sm" href="/admin/menus/@m.Key">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </ChildContent>
</AdminShell>
@code {
    [Parameter] public List<Menu> Menus { get; set; } = [];
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Error { get; set; }
}
