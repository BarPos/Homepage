<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Server -->
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15" />
        <PackageVersion Include="Markdig" Version="1.6.0" />
        <PackageVersion Include="HtmlSanitizer" Version="11.0.26" />
        <PackageVersion Include="QRCoder" Version="1.9.0" />
        <PackageVersion Include="MaxMind.Db" Version="5.3.0" />
        <!-- Tests -->
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    </ItemGroup>
</Project>
